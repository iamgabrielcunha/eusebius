{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamgabrielcunha/eusebius/schemas/language.schema.json",
  "title": "Language",
  "description": "A language as a graph node (§8).",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://github.com/iamgabrielcunha/eusebius/schemas/entity.base.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "language"
        },
        "id": {
          "type": "string",
          "pattern": "^language/"
        }
      },
      "required": [
        "bcp47"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "bcp47": {
      "$ref": "https://github.com/iamgabrielcunha/eusebius/schemas/language-map.schema.json#/$defs/bcp47"
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    }
  },
  "unevaluatedProperties": false
}
