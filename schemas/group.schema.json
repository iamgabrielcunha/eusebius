{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamgabrielcunha/eusebius/schemas/group.schema.json",
  "title": "Group",
  "description": "A people, tribe, civilisation or institution (§8).",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://github.com/iamgabrielcunha/eusebius/schemas/entity.base.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "group"
        },
        "id": {
          "type": "string",
          "pattern": "^group/"
        }
      },
      "required": [],
      "type": "object"
    }
  ],
  "properties": {
    "group_kind": {
      "type": "string",
      "enum": [
        "people",
        "tribe",
        "civilisation",
        "institution"
      ]
    }
  },
  "unevaluatedProperties": false
}
